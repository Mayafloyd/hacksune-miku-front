# Credenciales privadas del backend. Copia como .env.backend.
# Este archivo nunca se expone al navegador.

# Proveedor compatible con OpenAI usado por Jota y Mara.
LLM_PROVIDER=openai
PROVEEDOR=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Respaldos opcionales de Mara.
GROQ_API_KEY=
GEMINI_API_KEY=
