---
import AgentChoiceCard from "./AgentChoiceCard";
import jota from "../../assets/jota_bc.png";
import mara from "../../assets/mara_bc.png";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__geometry" aria-hidden="true">
    <span class="hero__diamond hero__diamond--one"></span>
    <span class="hero__diamond hero__diamond--two"></span>
    <span class="hero__route"></span>
  </div>

  <div class="hero__inner">
    <header class="hero__heading">
      <p class="hero__eyebrow">
        <span aria-hidden="true"></span>
        ¿Qué necesitas hoy?
      </p>
      <h1 id="hero-title">¿Cómo podemos ayudarte hoy?</h1>
      <p class="hero__lead">
        Encuentra el producto ideal para tu hogar o recibe acompañamiento técnico
        en pocos minutos.
      </p>
    </header>

    <div class="hero__choices" aria-label="Elige el tipo de asistencia">
      <div class="hero__choice hero__choice--sales">
        <AgentChoiceCard
          client:visible
          kind="sales"
          eyebrow="Para elegir mejor"
          title="Comprar con asesoría"
          description="Cuéntanos qué necesitas y encontraremos opciones adecuadas para tu hogar."
          cta="Hablar con ventas"
          href="/assistant/sales"
          portrait={jota.src}
          labels={[
            "Recomendaciones",
            "Comparaciones",
            "Características",
            "Crédito",
          ]}
        />
      </div>

      <div class="hero__choice hero__choice--support">
        <AgentChoiceCard
          client:visible
          kind="support"
          eyebrow="Para volver a estar bien"
          title="Solucionar un problema"
          description="Recibe orientación, consulta tu garantía o agenda una visita técnica."
          cta="Hablar con soporte"
          href="/assistant/support"
          portrait={mara.src}
          labels={["Diagnóstico", "Garantía", "Repuestos", "Visita técnica"]}
        />
      </div>
    </div>

    <p class="hero__trust">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M20 13c0 5-3.5 7.5-8 8.8C7.5 20.5 4 18 4 13V5l8-3 8 3z"></path>
        <path d="m9 12 2 2 4-4"></path>
      </svg>
      Orientación clara y segura, con respaldo para cada paso.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-height, 4.75rem));
    padding: clamp(3rem, 7vw, 6.5rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
    background:
      radial-gradient(
        circle at 8% 15%,
        rgb(201 214 0 / 0.11),
        transparent 19rem
      ),
      linear-gradient(
        180deg,
        var(--brand-white, #ffffff) 0%,
        var(--brand-surface, #f6f7f2) 100%
      );
    isolation: isolate;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--brand-lime, #c9d600),
      transparent
    );
    content: "";
    opacity: 0.75;
  }

  .hero__geometry {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__diamond {
    position: absolute;
    display: block;
    border: 1px solid rgb(17 17 17 / 0.06);
    transform: rotate(45deg);
  }

  .hero__diamond--one {
    top: 10%;
    right: -5rem;
    width: 17rem;
    height: 17rem;
  }

  .hero__diamond--two {
    bottom: 8%;
    left: -4.5rem;
    width: 9rem;
    height: 9rem;
    border-color: rgb(201 214 0 / 0.35);
  }

  .hero__route {
    position: absolute;
    top: 16%;
    left: 50%;
    width: 1px;
    height: 62%;
    background: linear-gradient(
      transparent,
      rgb(17 17 17 / 0.08),
      transparent
    );
  }

  .hero__inner {
    width: min(100% - 2.5rem, var(--content-wide, 78rem));
    margin-inline: auto;
  }

  .hero__heading {
    display: grid;
    max-width: 58rem;
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-flex;
    margin: 0 0 1rem;
    align-items: center;
    gap: 0.55rem;
    color: var(--brand-graphite, #252525);
    font-size: 0.76rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    animation: hero-rise 420ms 40ms ease both;
  }

  .hero__eyebrow > span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 0.12rem;
    background: var(--brand-lime, #c9d600);
    transform: rotate(45deg);
  }

  .hero h1 {
    max-width: 17ch;
    margin: 0;
    color: var(--brand-black, #111111);
    font-size: clamp(2.55rem, 6.8vw, 5.6rem);
    font-weight: 720;
    letter-spacing: -0.065em;
    line-height: 0.96;
    text-wrap: balance;
    animation: hero-rise 460ms 100ms ease both;
  }

  .hero__lead {
    max-width: 53ch;
    margin: clamp(1.1rem, 2.5vw, 1.6rem) 0 0;
    color: var(--brand-gray, #6b6b6b);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    line-height: 1.55;
    text-wrap: balance;
    animation: hero-rise 460ms 160ms ease both;
  }

  .hero__choices {
    display: grid;
    margin-top: clamp(2.2rem, 5vw, 4rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.75rem);
  }

  .hero__choice {
    min-width: 0;
    animation: hero-card-rise 540ms
      cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .hero__choice--sales {
    animation-delay: 220ms;
  }

  .hero__choice--support {
    animation-delay: 290ms;
  }

  .hero__trust {
    display: flex;
    margin: 1.35rem 0 0;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    color: var(--brand-gray, #6b6b6b);
    font-size: 0.82rem;
    font-weight: 590;
    text-align: center;
    animation: hero-rise 420ms 370ms ease both;
  }

  .hero__trust svg {
    flex: 0 0 auto;
    color: var(--brand-success, #287a3d);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(0.65rem);
    }
  }

  @keyframes hero-card-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media (max-width: 48rem) {
    .hero {
      padding-top: 2.75rem;
    }

    .hero__inner {
      width: min(100% - 1.5rem, var(--content-wide, 78rem));
    }

    .hero__choices {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__route {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .hero h1 {
      font-size: clamp(2.35rem, 12.5vw, 3.35rem);
    }

    .hero__trust {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (min-width: 100rem) {
    .hero {
      display: grid;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow,
    .hero h1,
    .hero__lead,
    .hero__choice,
    .hero__trust {
      animation-duration: 1ms;
      animation-delay: 0ms;
    }
  }
</style>
